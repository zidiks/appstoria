# Для `next dev` (next build/start читают .env.production). Значения те же:
# витрина поверх бэка macplus. На бэке в CORS разрешён http://localhost:3100.
API_UPSTREAM=https://api.macplus.by
# API_PROXY=true — браузер ходит на бэк через {сайт}/api (Next проксирует).
# Выключено: на shared-хостинге весь трафик шёл с одного IP и канал к бэку вставал
API_PROXY=false
NEXT_PUBLIC_HOST=https://appstoria.by
TURNSTILE_SITE_KEY=0x4AAAAAADygPJz9Vg2Cf5kV
