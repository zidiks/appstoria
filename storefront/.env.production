# Next читает этот файл и при `next build`, и при `next start`.
# Сейчас витрина работает поверх бэка macplus (см. site.config.js).
# Переменные окружения и build args в Docker перекрывают эти значения.
API_UPSTREAM=https://api.macplus.by
# Браузер ходит на бэк через {сайт}/api (Next проксирует). API_PROXY=false — напрямую
API_PROXY=true
NEXT_PUBLIC_HOST=https://appstoria.by
# Виджет Turnstile macplus — в Cloudflare у него должен быть хост appstoria.by
TURNSTILE_SITE_KEY=0x4AAAAAADygPJz9Vg2Cf5kV
