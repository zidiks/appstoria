# Скопируйте в .env и заполните:  cp .env.example .env

# Домены (A-записи всех трёх + www должны смотреть на IP сервера)
SITE_DOMAIN=app-storia.by
API_DOMAIN=api.app-storia.by
ADMIN_DOMAIN=admin.app-storia.by
# Почта для Let's Encrypt
ACME_EMAIL=hello@app-storia.by

# MongoDB
MONGODB_USER=appstoria
MONGODB_PASSWORD=change-me-long-random
MONGODB_NAME=appstoria

# JWT — длинная случайная строка, например: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Первый администратор: создаётся при старте, только если админов в базе ещё нет.
# После первого входа можно убрать.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Cloudflare Turnstile (капча на формах). Пусто — капча выключена.
# Ключи выпускаются на домен app-storia.by в панели Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_FORM_REQUIRE_TOKEN=false

# Уведомления о заказах в Telegram
TG_TOKEN=
TG_CHAT_ID=
